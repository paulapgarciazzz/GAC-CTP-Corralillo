APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=proyecto_db
DB_USERNAME=laravel_user
DB_PASSWORD=laravel_password

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database

QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# Mail Configuration with Resend
# Set MAIL_MAILER=resend to use Resend as the final mail provider
# For development/testing, use MAIL_MAILER=log to prevent sending real emails
MAIL_MAILER=log
MAIL_FROM_ADDRESS=notificaciones@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Resend Configuration
# Get your API key from https://resend.com/api-keys
# Once you have a verified domain with Resend, update MAIL_FROM_ADDRESS with an authorized sender
RESEND_API_KEY=