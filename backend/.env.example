APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=proyecto_db
DB_USERNAME=laravel_user
DB_PASSWORD=laravel_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SANCTUM_EXPIRATION=720 #12 horas
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# Mail Configuration with Resend
# Keep the log mailer for local development to avoid sending real emails
MAIL_MAILER=log
MAIL_FROM_ADDRESS=sistema@notificaciones.festivaldelatortilla.com
MAIL_FROM_NAME="CTP Corralillo"

# Resend Configuration
# Verified sending subdomain: notificaciones.festivaldelatortilla.com
# Set MAIL_MAILER=resend and a real API Key (scoped to that subdomain)
# only in your local .env when testing Resend. Never commit a real key.
RESEND_API_KEY=

# Administrador inicial (lo crea PermisosSeeder). Obligatorios para sembrar;
# usar credenciales propias por entorno y nunca subirlas al repositorio.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=